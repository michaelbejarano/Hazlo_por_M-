
---
---
<section class="hero" id="inicio">

  <div class="hero-bg" aria-hidden="true">
    <img src="images/fondo.jpg" alt="" />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-inner">

    <div class="hero-content">
      <span class="eyebrow">🤝 Tu ayuda está más cerca de lo que imaginas</span>

      <h1>
        ¿No tienes tiempo<br/> para realizar tus<br/>
        <em>encargos diarios?</em>
      </h1>

      <p class="hero-sub">
        HAZLO POR MÍ conecta a personas que necesitan ayuda con jóvenes colaboradores dispuestos a realizar pequeños encargos de forma rápida y sencilla.
      </p>

      <div class="hero-actions">
        <a href="#contacto" class="btn-primary">Solicitar ayuda ahora</a>
        <a href="#servicios" class="btn-ghost">Conocer servicios →</a>
      </div>

      <div class="hero-trust">
        <div class="trust-pill">⚡ Ahorra tiempo</div>
        <div class="trust-pill">⭐ Colaboradores calificados</div>
        <div class="trust-pill">📍 Servicio en Arequipa</div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">

      <div class="tech-dot dot-a"><span class="dot-icon">🛒</span><span class="dot-tag">Compras · En proceso</span></div>
      <div class="tech-dot dot-b"><span class="dot-icon">📦</span><span class="dot-tag">Recojo de paquete</span></div>
      <div class="tech-dot dot-c"><span class="dot-icon">📄</span><span class="dot-tag">Trámite · Completado</span></div>
      <div class="tech-dot dot-d"><span class="dot-icon">✅</span><span class="dot-tag">Encargo realizado</span></div>

      <div class="phone-mockup">
        <div class="phone-frame">
          <div class="phone-notch"></div>

          <div class="phone-screen">
            <div class="app-bar">
              <span class="app-logo">HAZLO POR MÍ</span>
              <span class="app-status">● Disponible</span>
            </div>

            <div class="app-map-area">
              <div class="mini-grid"></div>
              <div class="mini-ring r1"></div>
              <div class="mini-ring r2"></div>
              <div class="mini-pin">📍</div>
              <div class="mini-tech t1">🛒</div>
              <div class="mini-tech t2">📦</div>
              <div class="mini-tech t3">📄</div>
            </div>

            <div class="app-bottom">
              <p class="app-label">Colaboradores disponibles</p>

              <div class="app-techs">
                <div class="app-tech-card">
                  <span class="tc-icon">🛒</span>
                  <div>
                    <p class="tc-name">Compras del hogar</p>
                    <p class="tc-dist">Disponible · ⭐ 4.9</p>
                  </div>
                  <span class="tc-btn">Ver</span>
                </div>

                <div class="app-tech-card">
                  <span class="tc-icon">📦</span>
                  <div>
                    <p class="tc-name">Recojo de paquetes</p>
                    <p class="tc-dist">Disponible · ⭐ 4.8</p>
                  </div>
                  <span class="tc-btn">Ver</span>
                </div>
              </div>
            </div>
          </div>

          <div class="phone-home"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 7rem 2rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(10, 35, 35, 0.97) 0%,
        rgba(10, 35, 35, 0.88) 45%,
        rgba(10, 35, 35, 0.55) 70%,
        rgba(10, 35, 35, 0.35) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 35, 35, 0.4) 0%,
        transparent 40%,
        transparent 60%,
        rgba(10, 35, 35, 0.6) 100%
      );
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-block;
    background: rgba(20, 184, 166, 0.15);
    border: 1px solid rgba(20, 184, 166, 0.4);
    color: #5EEAD4;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 1.5rem;
  }

  h1 em {
    font-style: normal;
    color: #14B8A6;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(248, 250, 252, 0.8);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .btn-primary {
    background: #0F766E;
    color: #fff;
    padding: 0.875rem 1.75rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.975rem;
    transition: transform 0.2s, opacity 0.2s;
    box-shadow: 0 4px 24px rgba(20, 184, 166, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .btn-ghost {
    color: var(--white);
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.975rem;
    border: 1px solid rgba(255,255,255,0.25);
    backdrop-filter: blur(4px);
    background: rgba(255,255,255,0.06);
    transition: border-color 0.2s, background 0.2s;
  }

  .btn-ghost:hover {
    border-color: rgba(20, 184, 166, 0.6);
    background: rgba(20, 184, 166, 0.1);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .trust-pill {
    font-size: 0.78rem;
    color: rgba(248,250,252,0.7);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(6px);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 520px;
  }

  .tech-dot {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 10;
    animation: dot-appear 0.6s ease both, dot-float 4s ease-in-out infinite;
  }

  .tech-dot .dot-icon {
    background: rgba(10, 35, 35, 0.85);
    border: 2px solid #14B8A6;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    box-shadow: 0 0 14px rgba(20, 184, 166, 0.4);
    backdrop-filter: blur(6px);
    flex-shrink: 0;
  }

  .tech-dot .dot-tag {
    background: rgba(10, 35, 35, 0.8);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--white);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
    backdrop-filter: blur(6px);
  }

  .dot-a { top: 6%; left: -2%; animation-delay: 0.3s; }
  .dot-b { top: 16%; right: -4%; animation-delay: 0.9s; }
  .dot-c { bottom: 22%; left: -4%; animation-delay: 1.5s; }
  .dot-d { bottom: 10%; right: 2%; animation-delay: 2.1s; }

  @keyframes dot-appear {
    from { opacity: 0; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes dot-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  .phone-mockup {
    position: relative;
    z-index: 5;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.6)) drop-shadow(0 0 40px rgba(20,184,166,0.15));
  }

  .phone-frame {
    width: 240px;
    background: #102B2B;
    border-radius: 36px;
    border: 2px solid rgba(255,255,255,0.12);
    padding: 14px 8px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    position: relative;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.05),
      0 0 0 6px rgba(255,255,255,0.03);
  }

  .phone-notch {
    width: 70px;
    height: 20px;
    background: #102B2B;
    border-radius: 0 0 14px 14px;
    margin-bottom: 8px;
    border: 2px solid rgba(255,255,255,0.08);
    border-top: none;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .phone-screen {
    width: 100%;
    background: #F8FAFC;
    border-radius: 20px;
    overflow: hidden;
    flex: 1;
  }

  .phone-home {
    width: 70px;
    height: 4px;
    background: rgba(255,255,255,0.2);
    border-radius: 10px;
    margin-top: 12px;
  }

  .app-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px 8px;
    background: #E8F5F3;
    border-bottom: 1px solid #CFE7E2;
  }

  .app-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    color: #0F766E;
  }

  .app-status {
    font-size: 0.6rem;
    color: #0F766E;
    font-weight: 600;
  }

  .app-map-area {
    height: 160px;
    position: relative;
    background: #E8F5F3;
    overflow: hidden;
  }

  .mini-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(15,118,110,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,118,110,0.08) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .mini-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px solid rgba(15,118,110,0.25);
    transform: translate(-50%,-50%);
    animation: pulse-ring 3s ease-out infinite;
  }

  .r1 { width: 40px; height: 40px; animation-delay: 0s; }
  .r2 { width: 80px; height: 80px; animation-delay: 0.9s; }

  @keyframes pulse-ring {
    0% { opacity: 0.7; }
    100% { opacity: 0; transform: translate(-50%,-50%) scale(1.15); }
  }

  .mini-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    font-size: 1.1rem;
    z-index: 5;
    filter: drop-shadow(0 0 6px rgba(15,118,110,0.8));
  }

  .mini-tech {
    position: absolute;
    font-size: 0.85rem;
    background: rgba(255,255,255,0.95);
    border: 1px solid #0F766E;
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: dot-float 4s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(15,118,110,0.2);
  }

  .t1 { top: 20%; left: 65%; animation-delay: 0.4s; }
  .t2 { top: 60%; left: 20%; animation-delay: 1.1s; }
  .t3 { top: 30%; left: 30%; animation-delay: 1.8s; }

  .app-bottom { padding: 8px 10px 10px; }

  .app-label {
    font-size: 0.62rem;
    font-weight: 700;
    color: #0F766E;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .app-techs {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .app-tech-card {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #F0F7F6;
    border: 1px solid #D6E9E5;
    border-radius: 8px;
    padding: 6px 8px;
  }

  .tc-icon { font-size: 1rem; flex-shrink: 0; }

  .tc-name {
    font-size: 0.65rem;
    font-weight: 600;
    color: #173B3A;
    line-height: 1.2;
  }

  .tc-dist {
    font-size: 0.58rem;
    color: #68817E;
  }

  .tc-btn {
    margin-left: auto;
    background: #0F766E;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 5px;
    flex-shrink: 0;
  }

  /* RESPONSIVE ORIGINAL: CONSERVADO */
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-visual { height: 380px; }
    .phone-frame { width: 200px; }
    .app-map-area { height: 120px; }
    .dot-a { top: 2%; left: 2%; }
    .dot-b { top: 10%; right: 2%; }
    .dot-c { bottom: 28%; left: 2%; }
    .dot-d { bottom: 14%; right: 2%; }

    .hero-bg-overlay {
      background: linear-gradient(
        to bottom,
        rgba(10,35,35,0.95) 0%,
        rgba(10,35,35,0.85) 50%,
        rgba(10,35,35,0.75) 100%
      );
    }
  }
</style>
