
---
const services = [
  {
    icon: "🛒",
    title: "Compras",
    subtitle: "Del día a día",
    desc: "Realizamos tus compras del supermercado, mercado o tiendas cercanas.",
    tag: "Popular",
    img: "https://images.unsplash.com/photo-1542838132-92c53300491e?w=400&q=80"
  },
  {
    icon: "📦",
    title: "Recojo de paquetes",
    subtitle: "Entregas",
    desc: "Recogemos y llevamos tus paquetes, documentos y pedidos al destino indicado.",
    tag: "Más solicitado",
    img: "https://images.unsplash.com/photo-1607082349566-187342175e2f?w=400&q=80"
  },
  {
    icon: "📄",
    title: "Trámites",
    subtitle: "Gestiones personales",
    desc: "Te ayudamos con gestiones, colas y diligencias que requieren tiempo.",
    tag: "",
    img: "https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=400&q=80"
  },
  {
    icon: "🍔",
    title: "Pedidos",
    subtitle: "Comida y productos",
    desc: "Recogemos tus pedidos de restaurantes, tiendas y establecimientos.",
    tag: "",
    img: "https://images.unsplash.com/photo-1547592180-85f173990554?w=400&q=80"
  },
  {
    icon: "📚",
    title: "Apoyo académico",
    subtitle: "Estudios",
    desc: "Encuentra apoyo para tareas, materiales y actividades académicas.",
    tag: "",
    img: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=400&q=80"
  },
  {
    icon: "🏠",
    title: "Tareas del hogar",
    subtitle: "Ayuda cotidiana",
    desc: "Recibe apoyo con pequeñas actividades y pendientes de tu hogar.",
    tag: "",
    img: "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=400&q=80"
  },
];
---

<section class="services" id="servicios">
  <div class="services-header">
    <span class="section-label">Nuestros servicios</span>
    <h2>Deja tus pendientes<br/><em>en buenas manos</em></h2>
    <p>Publica lo que necesitas y encuentra a alguien dispuesto a ayudarte.</p>
  </div>

  <div class="slider">
    <button class="slider--btn slider--btn__prev" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>

    <div class="slides__wrapper">
      <div class="slides">
        {services.map((s, i) => (
          <div class="slide" data-index={i} class:list={[{ 'slide--current': i === 0, 'slide--next': i === 1, 'slide--previous': i === services.length - 1 }]}>
            <div class="slide__inner">
              <div class="slide--image__wrapper">
                <img class="slide--image" src={s.img} alt={s.title} loading="lazy" />
                <div class="slide--overlay"></div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {services.map((s, i) => (
        <div class="slide__bg" data-index={i} style={`--bg: url(${s.img})`} class:list={[{ 'slide__bg--current': i === 0, 'slide__bg--next': i === 1, 'slide__bg--previous': i === services.length - 1 }]}></div>
      ))}

      <div class="slides--infos">
        {services.map((s, i) => (
          <div class="slide-info" data-index={i} class:list={[{ 'slide-info--current': i === 0, 'slide-info--next': i === 1, 'slide-info--previous': i === services.length - 1 }]}>
            <div class="slide-info__inner">
              <div class="slide-info--text__wrapper">
                {s.tag && <span class="card-tag">{s.tag}</span>}
                <div data-title class="slide-info--text"><span>{s.icon} {s.title}</span></div>
                <div data-subtitle class="slide-info--text"><span>{s.subtitle}</span></div>
                <div data-description class="slide-info--text"><span>{s.desc}</span></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <button class="slider--btn slider--btn__next" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </div>

  <div class="slider-dots">
    {services.map((_, i) => (
      <button class:list={["dot", { "dot--active": i === 0 }]} data-dot={i} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<style>
  /* ---- Section shell ---- */
  .services {
    padding: 7rem 0 5rem;
    overflow: hidden;
    position: relative;
  }

  .services-header {
    max-width: 1100px;
    margin: 0 auto 3.5rem;
    padding: 0 2rem;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0F766E;
    margin-bottom: 1rem;
  }

  .services-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .services-header h2 em {
    font-style: normal;
    color: #0F766E;
  }

  .services-header p {
    color: var(--muted);
    font-size: 1rem;
  }

  /* ---- Slider layout ---- */
  :root {
    --slide-width: min(22vw, 260px);
    --slide-aspect: 2 / 3;
    --slide-transition: 700ms ease;
  }

  .slider {
    width: 100%;
    max-width: calc(3 * var(--slide-width) + 120px);
    margin: 0 auto;
    height: calc(var(--slide-width) * 1.6);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    position: relative;
  }

  .slider--btn {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border: 1px solid rgba(15,118,110,0.2);
    background: rgba(15,118,110,0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
    opacity: 0.7;
  }

  .slider--btn svg {
    stroke: #0F766E;
    width: 20px;
    height: 20px;
  }

  .slider--btn:hover {
    background: rgba(20,184,166,0.15);
    border-color: #0F766E;
    opacity: 1;
  }

  .slides__wrapper {
    flex: 1;
    height: 100%;
    display: grid;
    place-items: center;
    position: relative;
    & > * { grid-area: 1 / -1; }
  }

  .slides, .slides--infos {
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: grid;
    place-items: center;
    & > * { grid-area: 1 / -1; }
  }

  /* ---- Slides ---- */
  .slide {
    width: var(--slide-width);
    aspect-ratio: var(--slide-aspect);
    perspective: 800px;
    transition: transform var(--slide-transition);
    border-radius: 16px;
    overflow: hidden;
  }

  .slide--current {
    transform: perspective(1000px) translate3d(0, 0, 0) rotateY(0deg) scale(1.18);
    z-index: 20;
    pointer-events: auto;
  }

  .slide--next {
    transform: perspective(1000px) translate3d(calc(var(--slide-width) * 1.08), 0, 0) rotateY(-45deg) scale(1);
    z-index: 10;
  }

  .slide--previous {
    transform: perspective(1000px) translate3d(calc(var(--slide-width) * -1.08), 0, 0) rotateY(45deg) scale(1);
    z-index: 10;
  }

  .slide:not(.slide--current):not(.slide--next):not(.slide--previous) {
    transform: perspective(1000px) translate3d(0, 0, -200px) scale(0.7);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .slide__inner {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .slide--image__wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide--image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: filter var(--slide-transition);
  }

  .slide--current .slide--image {
    filter: brightness(0.75);
  }

  .slide--next .slide--image,
  .slide--previous .slide--image {
    filter: brightness(0.35) saturate(0.6);
  }

  .slide--overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,35,35,0.9) 0%, transparent 55%);
    border-radius: 16px;
  }

  /* ---- Background blur ---- */
  .slide__bg {
    position: fixed;
    inset: -20%;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    z-index: -1;
    pointer-events: none;
    transition: opacity var(--slide-transition), transform var(--slide-transition);
    opacity: 0;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(10,35,35,0.82);
      backdrop-filter: blur(10px);
    }
  }

  .slide__bg--current {
    opacity: 1;
    transform: translateX(0);
  }

  .slide__bg--previous {
    opacity: 0;
    transform: translateX(-8%);
  }

  .slide__bg--next {
    opacity: 0;
    transform: translateX(8%);
  }

  /* ---- Slide info text ---- */
  .slide-info {
    width: var(--slide-width);
    aspect-ratio: var(--slide-aspect);
    position: relative;
    z-index: 100;
    pointer-events: none;
  }

  .slide-info__inner {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .slide-info--text__wrapper {
    position: absolute;
    bottom: 14%;
    left: 0;
    padding: 0 1rem;
    width: 140%;
  }

  .card-tag {
    display: inline-block;
    background: rgba(20,184,166,0.2);
    border: 1px solid rgba(20,184,166,0.4);
    color: #5EEAD4;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .slide-info--text {
    overflow: hidden;

    & span {
      display: block;
      color: #fff;
      transition: opacity var(--slide-transition), transform var(--slide-transition);
    }

    &[data-title] span {
      font-family: var(--font-display);
      font-size: clamp(1rem, 2.2vw, 1.4rem);
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    &[data-subtitle] span {
      font-family: var(--font-display);
      font-size: clamp(0.75rem, 1.4vw, 0.95rem);
      font-weight: 500;
      color: #99D5CB;
      margin-left: 0.1rem;
    }

    &[data-description] span {
      font-size: clamp(0.65rem, 1.1vw, 0.78rem);
      color: rgba(255,255,255,0.8);
      margin-top: 0.3rem;
      line-height: 1.5;
    }
  }

  /* text animation */
  .slide-info--current .slide-info--text span {
    opacity: 1;
    transform: translate3d(0,0,0);
    transition-delay: 220ms;
  }

  .slide-info:not(.slide-info--current) .slide-info--text span {
    opacity: 0;
    transform: translate3d(0, 60%, 0);
    transition-delay: 0ms;
  }

  /* ---- Dots ---- */
  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .dot {
    width: 6px; height: 6px;
    border-radius: 100px;
    background: rgba(15,118,110,0.2);
    border: none;
    cursor: pointer;
    transition: background 0.3s, width 0.3s;
  }

  .dot--active {
    background: #0F766E;
    width: 22px;
  }

  /* ---- Responsive original conservado ---- */
  @media (max-width: 768px) {
    :root { --slide-width: min(42vw, 200px); }
    .slider { height: calc(var(--slide-width) * 1.65); }
  }

  @media (max-width: 480px) {
    :root { --slide-width: 58vw; }
    .slider { height: calc(var(--slide-width) * 1.7); }

    .slide--next, .slide--previous {
      transform: perspective(1000px) translate3d(calc(var(--slide-width) * 0.85), 0, 0) rotateY(-38deg) scale(0.88);
    }

    .slide--previous {
      transform: perspective(1000px) translate3d(calc(var(--slide-width) * -0.85), 0, 0) rotateY(38deg) scale(0.88);
    }
  }
</style>

<script>
  const TOTAL = document.querySelectorAll('.slide').length;

  let current = 0;

  const slides = [...document.querySelectorAll('.slide')];
  const slideInfos = [...document.querySelectorAll('.slide-info')];
  const slideBgs = [...document.querySelectorAll('.slide__bg')];
  const dots = [...document.querySelectorAll('.dot')];

  const wrap = (n: number, max: number) => ((n % max) + max) % max;

  function getRole(idx: number): 'current' | 'next' | 'previous' | null {
    if (idx === current) return 'current';
    if (idx === wrap(current + 1, TOTAL)) return 'next';
    if (idx === wrap(current - 1, TOTAL)) return 'previous';
    return null;
  }

  function applyClasses(el: Element, prefix: string, role: string | null) {
    el.classList.remove(`${prefix}--current`, `${prefix}--next`, `${prefix}--previous`);
    if (role) el.classList.add(`${prefix}--${role}`);
  }

  function render() {
    slides.forEach((el, i) => applyClasses(el, 'slide', getRole(i)));
    slideInfos.forEach((el, i) => applyClasses(el, 'slide-info', getRole(i)));
    slideBgs.forEach((el, i) => applyClasses(el, 'slide__bg', getRole(i)));
    dots.forEach((el, i) => el.classList.toggle('dot--active', i === current));
  }

  function change(dir: number) {
    current = wrap(current + dir, TOTAL);
    render();
  }

  function initTilt() {
    slides.forEach((slide) => {
      const inner = slide.querySelector('.slide__inner') as HTMLElement;
      if (!inner) return;
      let lerpX = 0, lerpY = 0, targetX = 0, targetY = 0;
      let rafId: number;

      slide.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = slide.getBoundingClientRect();
        const ox = (e.clientX - rect.left - rect.width / 2) / 8;
        const oy = (e.clientY - rect.top - rect.height / 2) / 10;
        targetX = ox;
        targetY = -oy;
      });

      slide.addEventListener('mouseleave', () => {
        targetX = 0;
        targetY = 0;
      });

      function tick() {
        lerpX += (targetX - lerpX) * 0.1;
        lerpY += (targetY - lerpY) * 0.1;
        inner.style.transform = `rotateY(${lerpX.toFixed(2)}deg) rotateX(${lerpY.toFixed(2)}deg)`;
        rafId = requestAnimationFrame(tick);
      }

      tick();
    });
  }

  document.querySelector('.slider--btn__prev')?.addEventListener('click', () => change(-1));
  document.querySelector('.slider--btn__next')?.addEventListener('click', () => change(1));

  dots.forEach((dot, i) => dot.addEventListener('click', () => {
    current = i;
    render();
  }));

  let touchStartX = 0;
  const wrapper = document.querySelector('.slides__wrapper')!;

  wrapper.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });

  wrapper.addEventListener('touchend', (e: TouchEvent) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) change(diff > 0 ? 1 : -1);
  });

  render();
  initTilt();
</script>
